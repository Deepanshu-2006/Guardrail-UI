{
  "name": "Guardrail Caretaker Portal",
  "short_name": "Guardrail",
  "description": "Trusted Contact Reviewer Portal for reviewing, evaluating, and monitoring high-risk browser interactions on behalf of designated wards.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#F5F3EC",
  "theme_color": "#1B2418",
  "categories": ["security", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
