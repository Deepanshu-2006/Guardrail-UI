{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "typeRoots": ["../extension/node_modules/@types", "../server/node_modules/@types"],
    "types": ["chrome", "node"]
  },
  "include": [
    "src/**/*"
  ]
}
