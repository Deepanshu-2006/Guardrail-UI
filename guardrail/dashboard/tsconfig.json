{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "typeRoots": ["../extension/node_modules/@types"],
    "types": ["chrome"]
  },
  "include": [
    "src/**/*",
    "../extension/src/types/**/*.ts",
    "../extension/src/approval/**/*.ts",
    "../extension/src/interception/**/*.ts",
    "../extension/src/staging/**/*.ts"
  ]
}
