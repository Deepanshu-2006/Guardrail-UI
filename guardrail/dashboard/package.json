{
  "name": "guardrail-dashboard",
  "version": "0.1.0",
  "description": "Guardrail UI - Trusted Contact Reviewer Portal & Dashboard Shell",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "start": "node dev.mjs",
    "build": "node build.mjs",
    "type-check": "../extension/node_modules/.bin/tsc --noEmit",
    "test:shell": "../extension/node_modules/.bin/esbuild src/tests/test-dashboard-shell.ts --bundle --format=esm --target=es2022 --outfile=dist/test-dashboard-shell.js && node dist/test-dashboard-shell.js",
    "test:verify-day12": "../extension/node_modules/.bin/esbuild src/tests/verify-day12-workflow.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/verify-day12-workflow.js && node dist/verify-day12-workflow.js",
    "test:sync": "../extension/node_modules/.bin/esbuild src/tests/test-dashboard-sync.ts --bundle --format=esm --target=es2022 --outfile=dist/test-dashboard-sync.js && node dist/test-dashboard-sync.js",
    "test:verify-complete-sync": "../extension/node_modules/.bin/esbuild src/tests/verify-complete-sync-flow.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/verify-complete-sync-flow.js && node dist/verify-complete-sync-flow.js",
    "test:dev": "node src/tests/test-dev-server.mjs",
    "test:social-auth": "../extension/node_modules/.bin/esbuild src/tests/test-social-auth.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-social-auth.js && node dist/test-social-auth.js",
    "test:push": "../extension/node_modules/.bin/esbuild src/tests/test-push-notifications.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-push-notifications.js && node dist/test-push-notifications.js",
    "test:multi-ward": "../extension/node_modules/.bin/esbuild src/tests/test-multi-ward.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-multi-ward.js && node dist/test-multi-ward.js",
    "test": "npm run test:shell && npm run test:verify-day12 && npm run test:sync && npm run test:verify-complete-sync && npm run test:dev && npm run test:social-auth && npm run test:push && npm run test:multi-ward"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.44.0"
  }
}
