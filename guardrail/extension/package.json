{
  "name": "guardrail-extension",
  "version": "0.1.0",
  "description": "Guardrail UI - Manifest V3 Browser Extension Foundation",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "type-check": "tsc --noEmit",
    "test:risk": "esbuild src/risk/test-risk-engine.ts --bundle --format=esm --target=es2022 --outfile=dist/test-risk-engine.js && node dist/test-risk-engine.js",
    "test:response": "esbuild src/response/test-response-pipeline.ts --bundle --format=esm --target=es2022 --outfile=dist/test-response-pipeline.js && node dist/test-response-pipeline.js",
    "test:interception": "esbuild src/interception/test-interception-model.ts --bundle --format=esm --target=es2022 --outfile=dist/test-interception-model.js && node dist/test-interception-model.js",
    "test:controller": "esbuild src/interception/test-interception-controller.ts --bundle --format=esm --target=es2022 --outfile=dist/test-interception-controller.js && node dist/test-interception-controller.js",
    "test:proof": "esbuild src/interception/test-action-interception.ts --bundle --format=esm --target=es2022 --outfile=dist/test-action-interception.js && node dist/test-action-interception.js",
    "test:continuation": "esbuild src/interception/test-action-continuation.ts --bundle --format=esm --target=es2022 --outfile=dist/test-action-continuation.js && node dist/test-action-continuation.js",
    "test:verify": "esbuild src/interception/verify-day8-scenarios.ts --bundle --format=esm --target=es2022 --outfile=dist/verify-day8-scenarios.js && node dist/verify-day8-scenarios.js",
    "test:staging": "esbuild src/staging/test-staging-context.ts --bundle --format=esm --target=es2022 --outfile=dist/test-staging-context.js && node dist/test-staging-context.js",
    "test:staging-ui": "esbuild src/staging/test-staging-ui.ts --bundle --format=esm --target=es2022 --outfile=dist/test-staging-ui.js && node dist/test-staging-ui.js",
    "test:verify-staging": "esbuild src/staging/verify-staging-workflow.ts --bundle --format=esm --target=es2022 --outfile=dist/verify-staging-workflow.js && node dist/verify-staging-workflow.js",
    "test:approval": "esbuild src/approval/test-approval-model.ts --bundle --format=esm --target=es2022 --outfile=dist/test-approval-model.js && node dist/test-approval-model.js",
    "test:approval-lifecycle": "esbuild src/approval/test-approval-lifecycle.ts --bundle --format=esm --target=es2022 --outfile=dist/test-approval-lifecycle.js && node dist/test-approval-lifecycle.js",
    "test:approval-auth": "esbuild src/approval/test-approval-authorization.ts --bundle --format=esm --target=es2022 --outfile=dist/test-approval-authorization.js && node dist/test-approval-authorization.js",
    "test:approval-service": "esbuild src/approval/test-approval-service.ts --bundle --format=esm --target=es2022 --outfile=dist/test-approval-service.js && node dist/test-approval-service.js",
    "test:approval-api": "esbuild src/approval/test-approval-api.ts --bundle --format=esm --target=es2022 --outfile=dist/test-approval-api.js && node dist/test-approval-api.js",
    "test:approval-client": "esbuild src/approval/test-approval-client.ts --bundle --format=esm --target=es2022 --outfile=dist/test-approval-client.js && node dist/test-approval-client.js",
    "test:approval-submit": "esbuild src/approval/test-submit-operation.ts --bundle --format=esm --target=es2022 --outfile=dist/test-submit-operation.js && node dist/test-submit-operation.js",
    "test:staging-approval-integration": "esbuild src/staging/test-staging-approval-integration.ts --bundle --format=esm --target=es2022 --outfile=dist/test-staging-approval-integration.js && node dist/test-staging-approval-integration.js",
    "test:staging-approval-status": "esbuild src/staging/test-staging-approval-status.ts --bundle --format=esm --target=es2022 --outfile=dist/test-staging-approval-status.js && node dist/test-staging-approval-status.js",
    "test:approval-status": "esbuild src/approval/test-approval-status-lookup.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-approval-status-lookup.js && node dist/test-approval-status-lookup.js",
    "test:approval-hardening": "esbuild src/approval/test-approval-hardening.ts --bundle --format=esm --target=es2022 --outfile=dist/test-approval-hardening.js && node dist/test-approval-hardening.js",
    "test:verify-approval": "esbuild src/approval/verify-day10-approval-workflow.ts --bundle --format=esm --target=es2022 --outfile=dist/verify-day10-approval-workflow.js && node dist/verify-day10-approval-workflow.js",
    "test:verify-day11": "esbuild src/approval/verify-day11-workflow.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/verify-day11-workflow.js && node dist/verify-day11-workflow.js",
    "test:approval-sync-client": "esbuild src/approval/test-approval-status-sync-client.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-approval-status-sync-client.js && node dist/test-approval-status-sync-client.js",
    "test:staging-sync": "esbuild src/staging/test-staging-approval-sync.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-staging-approval-sync.js && node dist/test-staging-approval-sync.js",
    "test:approval-binding": "esbuild src/approval/test-approval-action-binding.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-approval-action-binding.js && node dist/test-approval-action-binding.js",
    "test:approval-enforcement": "esbuild src/approval/test-approval-binding-enforcement.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-approval-binding-enforcement.js && node dist/test-approval-binding-enforcement.js",
    "test:approval-invalidation": "esbuild src/approval/test-approval-binding-invalidation.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-approval-binding-invalidation.js && node dist/test-approval-binding-invalidation.js",
    "test:continuation-auth": "esbuild src/interception/test-continuation-authorization.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-continuation-authorization.js && node dist/test-continuation-authorization.js",
    "test:action-continuation-state": "esbuild src/interception/test-action-continuation-state.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-action-continuation-state.js && node dist/test-action-continuation-state.js",
    "test:concurrency": "esbuild src/approval/test-approval-concurrency.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-approval-concurrency.js && node dist/test-approval-concurrency.js",
    "test:approval-binding-security": "esbuild src/approval/test-approval-binding-security.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-approval-binding-security.js && node dist/test-approval-binding-security.js",
