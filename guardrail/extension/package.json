    "test:staging-confirmation": "esbuild src/staging/test-staging-approval-confirmation.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-staging-approval-confirmation.js && node dist/test-staging-approval-confirmation.js",
    "test:controlled-continuation": "esbuild src/interception/test-controlled-action-continuation-integration.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-controlled-action-continuation-integration.js && node dist/test-controlled-action-continuation-integration.js",
    "test:continuation-hardening": "esbuild src/interception/test-continuation-hardening-regression.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-continuation-hardening-regression.js && node dist/test-continuation-hardening-regression.js",
    "test:contract": "esbuild src/risk/test-risk-evaluation-contract.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-risk-evaluation-contract.js && node dist/test-risk-evaluation-contract.js",
    "test:precedence": "esbuild src/risk/test-rule-precedence.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-rule-precedence.js && node dist/test-rule-precedence.js",
    "test:policies": "esbuild src/response/test-risk-policies.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/test-risk-policies.js && node dist/test-risk-policies.js",
    "test": "npm run test:policies && npm run test:contract && npm run test:precedence && npm run test:risk && npm run test:response && npm run test:interception && npm run test:controller && npm run test:proof && npm run test:continuation && npm run test:continuation-auth && npm run test:validation-service && npm run test:staging-confirmation && npm run test:controlled-continuation && npm run test:continuation-hardening && npm run test:action-continuation-state && npm run test:concurrency && npm run test:approval-binding-security && npm run test:verify && npm run test:staging && npm run test:staging-ui && npm run test:verify-staging && npm run test:approval && npm run test:approval-binding && npm run test:approval-enforcement && npm run test:approval-invalidation && npm run test:approval-lifecycle && npm run test:approval-auth && npm run test:approval-service && npm run test:approval-api && npm run test:approval-client && npm run test:approval-submit && npm run test:approval-status && npm run test:approval-sync-client && npm run test:approval-hardening && npm run test:staging-approval-integration && npm run test:staging-approval-status && npm run test:staging-sync && npm run test:verify-approval && npm run test:verify-day11"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
